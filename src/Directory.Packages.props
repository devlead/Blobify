<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Cake.Bridge.DependencyInjection" Version="2026.7.15.722" />
    <PackageVersion Include="Cake.Common" Version="6.2.0" />
    <PackageVersion Include="Cake.Testing" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Devlead.Console" Version="2026.8.13.844" />
    <PackageVersion Include="Devlead.Testing.MockHttp" Version="2026.8.14.900" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'"/>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.20" Condition="'$(TargetFramework)' == 'net9.0'"/>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" Condition="'$(TargetFramework)' == 'net10.0'"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="MimeTypes" Version="2.5.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Verify.NUnit" Version="32.0.0" />
  </ItemGroup>
</Project>